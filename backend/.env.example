# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/mss_db

# ─── Algorithm Weights ──────────────────────────────────────────────────────
VIX_WEIGHT=0.70
FNG_WEIGHT=0.30

# ─── VIX Mapping Range ──────────────────────────────────────────────────────
VIX_FLOOR=12
VIX_CEILING=40

# ─── Zone Boundaries (MSS thresholds) ───────────────────────────────────────
ZONE_EXTREME_PANIC=95
ZONE_TOTAL_PANIC=85
ZONE_HIGH_FEAR=65
ZONE_NEUTRAL=40
ZONE_HIGH_GREED=20

# ─── Action Percentages ─────────────────────────────────────────────────────
ACTION_EXTREME_PANIC_BUY_PCT=80
ACTION_TOTAL_PANIC_BUY_PCT=50
ACTION_HIGH_FEAR_BUY_PCT=25
ACTION_HIGH_GREED_TRIM_PCT=15
ACTION_EUPHORIA_TRIM_PCT=25

# ─── Stability & Cron ───────────────────────────────────────────────────────
STABILITY_READINGS=2
CRON_INTERVAL_MINUTES=30

# ─── Data Staleness ─────────────────────────────────────────────────────────
MAX_DATA_AGE_HOURS=24

# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ENABLED=true

# ─── Data Sources ───────────────────────────────────────────────────────────
FRED_API_KEY=your_fred_api_key_here

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
